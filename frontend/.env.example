################################################################################
# FRONTEND CLIENT-SIDE CONFIGURATION (Browser)
# These are prefixed with NEXT_PUBLIC_ to be accessible in browser
################################################################################

# Production backend URL - Used for browser requests to backend API
# LOCAL: http://localhost:8080
# PRODUCTION: https://studentpg-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8080

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

################################################################################
# SERVER-SIDE CONFIGURATION (Next.js Server, API Routes, Server Components)
# These are private and only accessible on the server
################################################################################

# Backend URL for server-to-server communication
# Can be internal Docker network URL in production
# LOCAL: http://localhost:8080
# PRODUCTION: https://studentpg-backend.onrender.com (or internal URL if available)
BACKEND_INTERNAL_URL=http://localhost:8080

################################################################################
# AUTHENTICATION & SECURITY
################################################################################

AUTH_COOKIE_NAME=access_token
COOKIE_SECRET=5f4dcc3b5aa765d61d8327deb882cf99a1a1e2a2c4a1b1c3d5e7f9a1b3d5e7f9

################################################################################
# EXTERNAL SERVICES (Client-Side Cloudinary Upload)
################################################################################

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tgsit4me
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=bhopal_pg_preset

################################################################################
